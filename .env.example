# ─────────────────────────────────────────────────────────────
#  로컬 개발은 이 파일을 .env.local 로 복사해서 채우세요.
#  Vercel 에 배포할 때는 같은 값을 Project Settings → Environment Variables 에 넣습니다.
# ─────────────────────────────────────────────────────────────

# ── Supabase (필수) ───────────────────────────────────────────
# Supabase 대시보드 → Project Settings → Data API / API Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...            # ⚠️ 절대 공개 금지 · 서버에서만 사용

# ── 관리자 페이지 (필수) ───────────────────────────────────────
# /admin 에서 참석 인원을 확인할 때 쓰는 비밀번호. 길고 추측하기 어렵게.
ADMIN_PASSWORD=

# ── 배포 주소 (권장) ──────────────────────────────────────────
# 카톡/문자 공유 시 미리보기(OG) 이미지 경로를 절대 URL로 만드는 데 쓰입니다.
NEXT_PUBLIC_SITE_URL=https://wedding.guwonsoft.com

# ── 카카오 (선택) ─────────────────────────────────────────────
# 지도 + 카카오톡 공유하기에 쓰입니다. 없으면 해당 기능만 자동으로 숨겨집니다.
# developers.kakao.com → 애플리케이션 → 앱 키 → JavaScript 키
# 반드시 [플랫폼 → Web]에 배포 도메인을 등록해야 지도가 표시됩니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
